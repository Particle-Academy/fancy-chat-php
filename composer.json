{
    "name": "particle-academy/fancy-chat-php",
    "description": "Laravel agent chat on Prism Harness: runs each turn on a Harness session (RunStep contract g282.1, streamed approvals, attachments) and serves it as an append-only thread log with an atomic, gapless seq, SSE plus long-poll with resumable replay, the turn machine, staged writes and decision endpoints that accept human actors only. Optional knowledge explorer on prism-graph. Twin of @particle-academy/fancy-chat-js.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "agent",
        "chat",
        "prism",
        "prism-harness",
        "human-in-the-loop",
        "hitl",
        "sse",
        "long-poll",
        "event-sourcing",
        "human-plus",
        "fancy",
        "particle-academy"
    ],
    "homepage": "https://github.com/Particle-Academy/fancy-chat-php",
    "support": {
        "issues": "https://github.com/Particle-Academy/fancy-chat-php/issues",
        "source": "https://github.com/Particle-Academy/fancy-chat-php"
    },
    "authors": [
        {
            "name": "Particle Academy",
            "homepage": "https://github.com/Particle-Academy"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/broadcasting": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/framework": "^13.0",
        "particle-academy/prism": ">=0.143 <2.0",
        "particle-academy/prism-harness": ">=0.26 <2.0"
    },
    "require-dev": {
        "particle-academy/prism-graph": "^0.4",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "particle-academy/prism-graph": ">=0.4, for FancyChat\\Prism\\KnowledgeBridge (the knowledge explorer's routes)"
    },
    "replace": {
        "particle-academy/fancy-chat-prism-php": "*"
    },
    "autoload": {
        "psr-4": {
            "FancyChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyChat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "@php tests/lint.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FancyChat\\FancyChatServiceProvider"
            ],
            "aliases": {
                "FancyChat": "FancyChat\\Facades\\FancyChat"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
